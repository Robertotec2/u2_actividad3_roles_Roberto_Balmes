# Copiar a .env y poner un valor generado con:
#   python -c "import secrets; print(secrets.token_hex(32))"
# .env esta en .gitignore: el secreto real nunca se sube.
JWT_SECRET=

# Opcional (Unidad 3): solo si el dashboard se sirve en otro puerto, por ejemplo
# CORS_ORIGINS=http://localhost:5173
CORS_ORIGINS=
